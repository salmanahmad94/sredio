{
    "name": "sredio",
    "version": "0.1.0",
    "private": true,
    "description": "A small Zapier-inspired workflow automation app (TypeScript, MEAN stack).",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @sredio/api",
        "test": "npm test -w @sredio/api",
        "typecheck": "npm run typecheck -w @sredio/api",
        "format": "prettier --write \"apps/*/src/**/*.ts\""
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": ">=22.22.3"
    }
}
