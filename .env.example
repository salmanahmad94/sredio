# Copy to .env and fill in. `npm run dev` loads it automatically.

NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/sredio

# Encrypts GitHub tokens and webhook secrets at rest. 32 bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Winston writes logs here (relative to apps/api).
LOG_DIRECTORY=logs
