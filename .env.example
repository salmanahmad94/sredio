# Copy to .env and fill in. `npm run dev` loads it automatically.

NODE_ENV=development
PORT=3000

# The GitHub OAuth App's callback URL must be <APP_URL>/auth/github/callback.
APP_URL=http://localhost:3000

# Public URL GitHub sends webhooks to. In development, run a tunnel and paste its URL:
#   ngrok http 3000  →  https://abc123.ngrok-free.app
# Without it, Zaps can be saved but not turned on.
PUBLIC_URL=

MONGODB_URI=mongodb://127.0.0.1:27017/sredio

# Encrypts GitHub tokens and webhook secrets at rest. 32 bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Sign the session JWTs. Generate each with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# true when served over HTTPS
COOKIE_SECURE=false

# From https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Winston writes logs here (relative to apps/api).
LOG_DIRECTORY=logs
