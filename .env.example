# Copy to .env and fill in. `npm run dev` loads it automatically.

NODE_ENV=development
PORT=3000

# Where you open the app: http://localhost:4200 with `npm run dev`, http://localhost:3000 with
# `npm start`. The GitHub OAuth App's callback URL must be <APP_URL>/auth/github/callback.
APP_URL=http://localhost:4200

# Public URL GitHub sends webhooks to. In development, run a tunnel and paste its URL:
#   ngrok http 3000  →  https://abc123.ngrok-free.app
# Without it, Zaps can be saved but not turned on.
PUBLIC_URL=

MONGODB_URI=mongodb://127.0.0.1:27017/sredio

# Background jobs (Agenda), stored in the same database.
AGENDA_COLLECTION=agendaJobs
AGENDA_PROCESS_EVERY=10 seconds
AGENDA_MAX_CONCURRENCY=20

# Encrypts GitHub tokens and webhook secrets at rest. 32 bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Sign the session JWTs. Generate each with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# true when served over HTTPS
COOKIE_SECURE=false

# From https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. The Copilot drafts Zaps from a description; without a key it answers 503.
OPENAI_API_KEY=
COPILOT_MODEL=gpt-6.2-sol

# Winston writes logs here (relative to apps/api).
LOG_DIRECTORY=logs
